# Copy this file to .env and fill in each required secret before starting Compose.
# Generate each secret with: openssl rand -hex 32

GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Use a hex-generated password (letters/numbers only) because it is embedded in
# PostgreSQL connection URLs.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# This is the single account allowed to sign in to the Chainlit UI.
PAPERMIND_ADMIN_USERNAME=admin
PAPERMIND_ADMIN_PASSWORD=
CHAINLIT_AUTH_SECRET=

# Optional host ports. Both services bind to loopback; use SSH forwarding or
# the included Cloudflare Tunnel profile for remote browser access.
CHAINLIT_PORT=8001
API_PORT=8000

# Optional: named Cloudflare Tunnel token, for publishing the UI without
# opening an inbound application port on the VM.
CLOUDFLARE_TUNNEL_TOKEN=
